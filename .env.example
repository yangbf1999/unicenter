# UniCenter shared environment (repo root)
# `./deploy.sh` copies this file to the Git-ignored .env on first run,
# generates the security values, and sets the public URL. Manual copies must
# replace every `change-me` value before use.
#
# One file for:
#   - docker compose / redeploy.sh  (env_file: .env)
#   - Next.js + ws-proxy local dev  (frontend/.env → symlink to this file)
#
# Local-only overrides (localhost URLs, etc.): put them in frontend/.env.example
# → frontend/.env.local (Next loads .env.local over the shared file; compose ignores it).
#
# Link helper:  node frontend/scripts/ensure-shared-env.js

# ========================================
# Required - Security Keys
# ========================================
# Generate with: openssl rand -base64 32
APP_SECRET=your-app-secret-change-me
NEXTAUTH_SECRET=your-nextauth-secret-change-me

# ========================================
# Optional - Application URLs
# ========================================
# Public repository used by the About page and version checker.
NEXT_PUBLIC_GITHUB_REPO=yangbf1999/unicenter
# By default AUTH_TRUST_HOST lets NextAuth derive the public origin from the
# browser Host / X-Forwarded-* headers — no baked IP:port needed. Set
# NEXTAUTH_URL (and APP_URL) only when you need a fixed override: OIDC/SSO
# callback registration, or TLS terminated in a way that does not forward
# X-Forwarded-Proto. deploy.sh: DEPLOY_PUBLIC_URL=https://host writes both.
AUTH_TRUST_HOST=true
# NEXTAUTH_URL=https://unicenter.example.com
# APP_URL=https://unicenter.example.com

# ========================================
# Optional - Session timeouts
# ========================================
# How long a browser session may live, in seconds. The database session row
# is authoritative — it is what actually revokes access — and the session
# cookie's own lifetime is derived from SESSION_ABSOLUTE_TIMEOUT so it can
# never outlive that row.
# SESSION_IDLE_TIMEOUT: time without activity before a session expires. Default: 43200 (12 hours)
# SESSION_ABSOLUTE_TIMEOUT: max session lifetime regardless of activity. Default: 604800 (7 days)
# SESSION_IDLE_TIMEOUT=43200
# SESSION_ABSOLUTE_TIMEOUT=604800

# Cloud image catalog (Automation > Templates). The built-in image list is also
# published as JSON in the public repo and re-fetched once a day, so new
# distribution releases show up without upgrading UniCenter.
# TEMPLATE_CATALOG_URL: where to fetch it. Point it at an internal mirror of the
# same file on an air-gapped network.
# TEMPLATE_CATALOG_AUTO_UPDATE: set to "false" to disable the daily fetch. The
# "Check for updates" button on the catalog tab keeps working.
# TEMPLATE_CATALOG_URL=
# TEMPLATE_CATALOG_AUTO_UPDATE=true

# ========================================
# Optional - First-run setup secret
# ========================================
# POST /api/v1/auth/setup creates the first administrator and is reachable
# without authentication for as long as no account exists. That window is how
# a fresh install bootstraps, and it closes for good once one account exists.
# Set this on an instance whose first boot happens on a network someone else
# can reach: the setup request must then carry the same value in its
# x-setup-token header. Unset keeps the historical behaviour.
# UNICENTER_SETUP_TOKEN=

# ========================================
# Optional - Air-gapped site
# ========================================
# UNICENTER_OFFLINE: set to "true" on a host without internet access. The
# version check, the GitHub badge and the catalog refresh stay quiet, and the
# maps explain why they show no tiles. Set UNICENTER_IMAGE / POSTGRES_IMAGE when a
# disconnected site mirrors the Community images into a local registry.
# UNICENTER_OFFLINE=
# POSTGRES_IMAGE=postgres:16-alpine

# ========================================
# Database (Postgres)
# ========================================
# Postgres credentials for the bundled `postgres` compose service.
# In production these MUST be set to values you control. The defaults
# below are only suitable for local testing.
POSTGRES_USER=unicenter
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=unicenter

# Frontend connection string. Compose injects DATABASE_URL for the frontend
# service from POSTGRES_* (hostname `postgres`). For `npm run dev` against a
# published host port, set DATABASE_URL here or in frontend/.env.local, e.g.:
# DATABASE_URL=postgresql://unicenter:change-me-please@127.0.0.1:5433/unicenter?schema=public
#
# Shared secret for ws-proxy <-> /api/internal/* (auto-generated by
# frontend/scripts/ensure-internal-token.js into this file if missing).
# INTERNAL_API_TOKEN=

# ========================================
# Optional - Instance identity
# ========================================
# Identity this frontend stamps on the migration jobs it runs, so a boot can
# fail the ones its own previous incarnation left behind instead of showing them
# as "In progress" forever. The single-node compose stacks already set it; leave
# it alone unless several frontends share one database, in which case every one
# of them needs its OWN value. Two instances sharing a value means a boot fails
# its live peers' migration jobs.
# UNICENTER_INSTANCE_ID=unicenter-frontend

# ========================================
# Optional - eSage and migration budgets (milliseconds)
# ========================================
# UNISPHERE_TIMEOUT_MS: budget for a regular eSage API call. Default 8000.
# UNISPHERE_SLOW_READ_TIMEOUT_MS: budget for the reads that enumerate every storage,
# such as the migration Target Storage list. Default 30000. Raise it on a
# datacenter declaring many PBS targets.
# V2V_ROOT_CHOICE_TIMEOUT_MS: how long a cold migration waits for an operator
# to pick the root filesystem before releasing the node temp storage.
# Default 7200000, two hours.
# UNISPHERE_TIMEOUT_MS=8000
# UNISPHERE_SLOW_READ_TIMEOUT_MS=30000
# V2V_ROOT_CHOICE_TIMEOUT_MS=7200000

# ========================================
# Optional - Community image pinning
# ========================================
# UNICENTER_IMAGE=unicenter-frontend:1.0.0
